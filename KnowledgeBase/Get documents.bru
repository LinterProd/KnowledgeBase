meta {
  name: Get documents
  type: http
  seq: 12
}

get {
  url: {{url}}/api/documents?status=PUBLISHED&page=0&size=10&sort=createdAt,desc
  body: json
  auth: inherit
}

params:query {
  status: PUBLISHED
  page: 0
  size: 10
  sort: createdAt,desc
}

settings {
  encodeUrl: true
  timeout: 0
}
